# 复制成 .env 之前先跑 scripts/render-env.sh。不要把填好密钥的 .env 提交进 git。
# 对外只使用单域名 lobe.85718571.xyz，网关和 S3 通过 Nginx 子路径转发。

# 默认使用你自己的 wq 分支构建镜像（国内走南大 ghcr 镜像源加速）
LOBE_IMAGE=ghcr.nju.edu.cn/goldendecade/lobehub:wq
LOBE_PORT=3210
RUSTFS_PORT=9000
APP_URL=https://lobe.85718571.xyz
INTERNAL_APP_URL=http://localhost:3210

# scripts/render-env.sh 生成，不要手写、不要更换。更换后已加密的数据解不开。
KEY_VAULTS_SECRET=
AUTH_SECRET=
GATEWAY_SERVICE_TOKEN=
JWKS_KEY=
JWKS_PUBLIC_KEY=

LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=

RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_LOBE_BUCKET=lobe
# 配合 S3_ENABLE_PATH_STYLE=1，预签名地址形如 https://lobe.85718571.xyz/lobe/<key>，由 Nginx /lobe/ 转发到 127.0.0.1:9000
S3_ENDPOINT=https://lobe.85718571.xyz

# 宿主机端口。容器内 Agent Gateway 仍是 8787，这里只改左边。
AGENT_GATEWAY_PORT=9989
DEVICE_GATEWAY_PORT=8788
# 浏览器访问的地址，走单域名的 /agent-gw 子路径反代到 127.0.0.1:9989
AGENT_GATEWAY_URL=https://lobe.85718571.xyz/agent-gw
# lobe 容器访问设备网关，走 compose 网络，不要改成公网地址。
DEVICE_GATEWAY_URL=http://gateway:8788
# 客户端发现的公网设备网关地址，走单域名的 /device-gw 子路径反代到 127.0.0.1:8788
DEVICE_GATEWAY_PUBLIC_URL=https://lobe.85718571.xyz/device-gw

# 允许公司域名及个人邮箱注册（如需完全开放注册，改为空 AUTH_ALLOWED_EMAILS= 即可）
AUTH_ALLOWED_EMAILS=microhealthlab.com,then_0904@qq.com
